{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tally",
  "account_id": "2ecfb65ac837bf16bb96da2c6d1ea96e",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tally-db",
      "database_id": "f2f13400-9fec-4e4a-a012-0f2389e25408",
      "migrations_dir": "drizzle"
    }
  ],
  // Per-IP brake on sign-in; namespace 2001 is Tally's own, so it shares no counters with other Workers.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "2001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "ENVIRONMENT": "production",
    "MAIL_FROM": "noreply@tally.vitex.dev",
    "NUXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFKiGfbRHZaRDyPQ"
  }
}
