{
  "name": "tally",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "nuxt dev --port 3300",
    "build": "nuxt build",
    "preview": "wrangler dev",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "typecheck": "nuxt typecheck && tsc --noEmit -p server/tsconfig.json",
    "types": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "bank": "node scripts/generate-bank.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply tally-db --local",
    "db:migrate": "wrangler d1 migrations apply tally-db --remote"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.2",
    "drizzle-orm": "^0.45.3",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@iconify-json/ph": "^1.2.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-plugin-format": "^2.0.1",
    "h3": "1.15.11",
    "typescript": "~6.0.3",
    "vite-plus": "^1.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.143.1"
  }
}
