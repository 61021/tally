# Local dev only. Production values are Worker secrets.
NUXT_SESSION_PASSWORD=at-least-32-characters-of-random-text
NUXT_EMAIL_HASH_KEY=any-random-text-for-local-dev
# Cloudflare's always-pass Turnstile test keys
NUXT_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
